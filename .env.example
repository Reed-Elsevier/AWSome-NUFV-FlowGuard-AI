# AI Provider: 'anthropic' or 'openai'
AI_PROVIDER=anthropic

# API Keys (leave empty here - manually populate in .env)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional Model override (e.g. claude-3-5-sonnet-20241022 or gpt-4o-mini)
AI_MODEL=

# Data root folder containing Parquet files
DATA_ROOT=./data

# Server settings
HOST=0.0.0.0
PORT=8000
